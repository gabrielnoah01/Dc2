{
  "name": "only",
  "version": "0.1.4",
  "description": "Chat, voz e compartilhamento de tela P2P — sem servidor central",
  "main": "dist/main/index.js",
  "author": "gabrielnoah",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n main,vite,electron -c yellow,cyan,magenta \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js && cross-env NODE_ENV=development electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder --win",
    "dist:dir": "npm run icon && npm run build && electron-builder --win --dir",
    "release": "npm run icon && npm run build && electron-builder --win --publish always",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@runonflux/nat-upnp": "^1.0.2",
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.2"
  }
}
